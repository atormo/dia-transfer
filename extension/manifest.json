{
  "manifest_version": 3,
  "name": "Dia Transfer",
  "description": "Copy bookmarks and extensions from one browser profile to another, directly.",
  "version": "1.1.0",
  "key": "",
  "permissions": [
    "bookmarks",
    "management",
    "nativeMessaging",
    "storage",
    "favicon",
    "history"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Dia Transfer",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
